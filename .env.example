# ---- Core -------------------------------------------------------------
DATABASE_URL=postgres://veylo:veylo@localhost:5432/veylo
POSTGRES_PORT=5432
MCP_PORT=8787
MCP_SERVER_URL=http://127.0.0.1:8787/mcp
# MCP server security. Defaults bind to loopback only.
MCP_HOST=127.0.0.1
# Extra browser origins allowed to call /mcp (loopback origins are always allowed).
MCP_ALLOWED_ORIGINS=
# Required to bind to a non-loopback host. Clients send: Authorization: Bearer <token>
MCP_AUTH_TOKEN=
# false = SSE-framed responses instead of plain JSON
MCP_JSON_RESPONSE=true
# Optional: enables the search_web tool (Brave Search API)
BRAVE_SEARCH_API_KEY=

# ---- AI layer (provider-agnostic) --------------------------------------
# rules   = no keys needed, always works (default so a fresh clone runs)
# bedrock | gemini | openai = need credentials; any failure falls back to rules
AI_PROVIDER=rules

# ---- AWS Bedrock (AWS Builder mini challenge) --------------------------
# Optional. Veylo runs without AWS. Set AI_PROVIDER=bedrock to use it.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # only for temporary credentials
# Cross-region inference profile ID (geo prefix: us. / eu. / apac.).
# Verify it exists for your account + region before relying on it:
#   aws bedrock list-inference-profiles --region $AWS_REGION
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_MAX_TOKENS=1024

# ---- Other providers (optional) ----------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---- Features -----------------------------------------------------------
DEMO_MODE=false
ENABLE_IMAGE_IDENTIFICATION=false
GOOGLE_PLACES_API_KEY=

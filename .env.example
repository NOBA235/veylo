# ---- Core -------------------------------------------------------------
# Amazon RDS / Aurora PostgreSQL Serverless v2 (or local Docker Postgres)
# Local:      postgres://veylo:veylo@localhost:5432/veylo
# Amazon RDS: postgres://veyloadmin:password@your-db.cxxxxxx.us-east-1.rds.amazonaws.com:5432/veylo?sslmode=require
DATABASE_URL=postgres://veylo:veylo@localhost:5432/veylo
POSTGRES_PORT=5432
MCP_PORT=8787
MCP_SERVER_URL=http://127.0.0.1:8787/mcp
# MCP server security. Defaults bind to loopback only.
MCP_HOST=127.0.0.1
# Extra browser origins allowed to call /mcp (loopback origins are always allowed).
MCP_ALLOWED_ORIGINS=
# Required to bind to a non-loopback host. Clients send: Authorization: Bearer <token>
MCP_AUTH_TOKEN=
# false = SSE-framed responses instead of plain JSON
MCP_JSON_RESPONSE=true
# Optional: enables the search_web tool (Brave Search API)
BRAVE_SEARCH_API_KEY=

# ---- AI Engine (Amazon Bedrock & Deterministic Rules) -------------------
# rules   = deterministic offline rules (zero keys needed, zero failure rate)
# bedrock = Amazon Bedrock Converse API (AWS Builder Mini Challenge)
AI_PROVIDER=rules

# ---- AWS Infrastructure (Bedrock & Amazon Polly) -----------------------
# Standard AWS IAM credentials for Amazon Bedrock and Amazon Polly.
# If omitted or unconfigured, Bedrock falls back cleanly to deterministic rules,
# and voice synthesis falls back cleanly to the browser's natural speech engine.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # only for temporary / STS credentials
# Cross-region inference profile ID or foundation model ID:
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_MAX_TOKENS=1024

# ---- Voice Synthesis (Amazon Polly Alexa+ Neural TTS) ------------------
# Native Amazon Polly neural speech synthesis for authentic Alexa voice persona.
# Uses the AWS credentials configured above.
# Default voice: "Joanna" (neural engine) - Alexa's natural voice persona.
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural

# ---- Features -----------------------------------------------------------
DEMO_MODE=false
ENABLE_IMAGE_IDENTIFICATION=false
GOOGLE_PLACES_API_KEY=
